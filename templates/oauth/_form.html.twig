{#
    Reusable form-control markup for the OAuth screens (see the styles in base.html.twig).
    Import with: {% import 'oauth/_form.html.twig' as form %}
#}

{% macro label(for, text) %}
    <label class="label" for="{{ for }}">{{ text }}</label>
{% endmacro %}

{% macro field(name, label, type = 'text', value = '', placeholder = '', autocomplete = '', required = true, autofocus = false) %}
    <div class="field">
        {{ _self.label(name, label) }}
        <input
            class="input"
            type="{{ type }}"
            id="{{ name }}"
            name="{{ name }}"
            value="{{ value }}"
            {%- if placeholder %} placeholder="{{ placeholder }}"{% endif %}
            {%- if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}
            {%- if required %} required{% endif %}
            {%- if autofocus %} autofocus{% endif %}
        >
    </div>
{% endmacro %}

{% macro submit(label, variant = 'primary', name = '', value = '', extraClass = '') %}
    <button
        type="submit"
        class="btn btn-{{ variant }}{% if extraClass %} {{ extraClass }}{% endif %}"
        {%- if name %} name="{{ name }}"{% endif %}
        {%- if value %} value="{{ value }}"{% endif %}
    >{{ label }}</button>
{% endmacro %}
